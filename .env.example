# VLM provider. GLM is the default; use `openai` to switch providers.
VLM_PROVIDER=glm

# Z.AI API key for the default GLM-4.6V-Flash provider.
GLM_API_KEY=
GLM_VLM_MODEL=glm-4.6v-flash

# OpenAI is optional. Set VLM_PROVIDER=openai to use these values instead.
# OPENAI_API_KEY=
# OPENAI_VLM_MODEL=gpt-5-mini
# VLM_MODEL=  # Optional common override for the selected provider.

# Notion Integration token.
NOTION_API_KEY=

# Notion 本棚 page data source ID.
NOTION_BOOKSHELF_DATA_SOURCE_ID=00000000-0000-0000-0000-000000000000

# Bearer token required by the image registration API.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
BOOK_REGISTER_API_TOKEN=

# Docker Compose publishes the container port to this address on the host.
# Keep 127.0.0.1 for a local reverse proxy. For Tailnet-only access, use the
# host's Tailscale address rather than 0.0.0.0.
BOOK_REGISTER_BIND_ADDRESS=127.0.0.1

# Optional Cloudflare Tunnel image. The token is kept separately in .cloudflare.env.
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
